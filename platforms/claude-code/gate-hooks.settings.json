{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__PLUGIN_ROOT__/hooks/gate-enforce.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__PLUGIN_ROOT__/hooks/gate-beacon.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
