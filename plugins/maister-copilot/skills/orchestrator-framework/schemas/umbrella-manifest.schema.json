{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maister.dev/schemas/contracts/umbrella-manifest",
  "title": "Umbrella manifest",
  "description": "Contract C1. Created when a workspace is initialized as an umbrella; additive thereafter. Members keep their own task trees, so mixed-era layouts are allowed.",
  "type": "object",
  "required": ["version", "members"],
  "properties": {
    "version": { "$ref": "https://maister.dev/schemas/contracts/common#/$defs/version1" },
    "umbrella_id": {
      "description": "Stable across reinstall.",
      "$ref": "https://maister.dev/schemas/contracts/common#/$defs/short_id"
    },
    "members": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/member" }
    },
    "branch_convention": {
      "description": "Template for the branch a dispatch works on. Placeholders are substituted by the engine; an absent convention leaves branch choice to the worker.",
      "type": ["string", "null"]
    },
    "coordination": {
      "description": "The coordination branch and the worktree it is mounted at.",
      "type": "object",
      "properties": {
        "branch": { "type": ["string", "null"] },
        "worktree": { "type": ["string", "null"] },
        "retention": {
          "type": "object",
          "properties": { "days": { "type": ["integer", "null"] } }
        }
      }
    },
    "tracker": {
      "description": "Optional issue-tracker mirror. Absent means no mirror is written.",
      "type": "object",
      "properties": {
        "kind": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "mirror": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "scope": { "type": ["string", "null"] }
          }
        }
      }
    },
    "git_host": {
      "description": "Where the members are hosted. Used to build pull-request links; nothing is fetched.",
      "type": "object",
      "properties": {
        "kind": { "type": ["string", "null"] },
        "org": { "type": ["string", "null"] }
      }
    },
    "routing": {
      "description": "Data for the intake node. Reserved (contract R): parsed, warned about, inert.",
      "type": "object",
      "properties": { "tiers": { "type": "object" } }
    },
    "knowledge": {
      "description": "Provenance-checked notes directory.",
      "type": ["string", "null"]
    },
    "retention": {
      "type": "object",
      "properties": {
        "days": { "type": ["integer", "null"] },
        "lfs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "defaults": {
      "type": "object",
      "properties": {
        "autonomy": { "$ref": "#/$defs/autonomy" },
        "worktree": { "type": "boolean" },
        "provider": { "$ref": "#/$defs/provider" }
      }
    }
  },
  "$defs": {
    "autonomy": {
      "description": "Permission preset per dispatch. The attended tier always pauses on push, merge and pull-request creation.",
      "enum": ["attended", "auto-low", "auto-medium", "auto-high"]
    },
    "provider": {
      "description": "Which coding agent runs a dispatched node. Resolved node, then member, then the workspace default; a node whose provider resolves nowhere is a validation error.",
      "enum": ["claude", "copilot"]
    },
    "member": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "$ref": "https://maister.dev/schemas/contracts/common#/$defs/rel_path" },
        "kind": { "type": "string" },
        "default_provider": { "$ref": "#/$defs/provider" },
        "autonomy": {
          "description": "Per-member permission tier. Absent means the umbrella default applies.",
          "$ref": "#/$defs/autonomy"
        }
      }
    },
    "person": {
      "description": "Identity mapping. When absent, accounts are matched by e-mail.",
      "type": "object",
      "properties": {
        "id": { "$ref": "https://maister.dev/schemas/contracts/common#/$defs/short_id" },
        "members": {
          "description": "Member names this person owns. Names, not paths: a member is looked up in the members map.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "email": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "github": { "type": ["string", "null"] },
        "gitlab": { "type": ["string", "null"] },
        "jira": { "type": ["string", "null"] }
      }
    }
  }
}
